# Postiz settings. Copy to /opt/postiz/.env (chmod 600) and fill it in; see RUNBOOK.md.
# Never commit the filled-in file. Empty values below are filled on the server only.
# Full reference: https://docs.postiz.com/configuration/reference

# --- Where Postiz is reached (the Cloudflare tunnel hostname). Must match exactly, https included.
MAIN_URL=https://postiz.techinsiderbytes.com
FRONTEND_URL=https://postiz.techinsiderbytes.com
# The backend sits behind the same host under /api.
NEXT_PUBLIC_BACKEND_URL=https://postiz.techinsiderbytes.com/api

# --- Local port the web app listens on (127.0.0.1 only). Check it is free first: ss -ltn 'sport = :5300'
POSTIZ_PORT=5300

# --- Secrets: generate each one with  openssl rand -hex 32  (hex keeps them URL-safe).
# Signs login sessions. Changing it logs everyone out.
JWT_SECRET=
# Password of Postiz's own Postgres (user "postiz", database "postiz").
POSTIZ_DB_PASSWORD=
# Password of Temporal's Postgres (user "temporal"). Temporal runs Postiz's scheduled jobs.
TEMPORAL_DB_PASSWORD=

# --- Sign-ups. Keep false until the admin account exists, then set true and restart (RUNBOOK step 8).
DISABLE_REGISTRATION=false

# --- Public API: max posts created per hour through the API (clipfarm posts through it).
API_LIMIT=30

# --- Storage is local: uploads go to /opt/postiz/uploads (set in docker-compose.yml, nothing to fill).

# --- Social platforms (RUNBOOK step 9 says where to get each value and which callback URL to paste).
# YouTube (Google Cloud OAuth client, type "Web application")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok (TikTok for Developers app with Login Kit + Content Posting API)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Instagram, professional account without a Facebook page ("Instagram (Standalone)" in Postiz)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Instagram through a Facebook page ("Instagram (Facebook Business)" in Postiz) and Facebook pages
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# X (developer app API Key and Secret, OAuth 1.0a)
X_API_KEY=
X_API_SECRET=
