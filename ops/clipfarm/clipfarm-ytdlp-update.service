# Installs the newest yt-dlp release and goes back if it breaks (ytdlp-update.sh). Installed by install-autodeploy.sh.
[Unit]
Description=Update yt-dlp for clipfarm, with rollback
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/local/lib/clipfarm/ops/clipfarm/ytdlp-update.sh
TimeoutStartSec=15min
Nice=10
