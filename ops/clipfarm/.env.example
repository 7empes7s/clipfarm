# clipfarm on the live box. Copy to /etc/clipfarm/clipfarm.env (mode 600, owner root): RUNBOOK.md
# step 4. Never commit the filled file. systemd reads it: no quotes, no "export".
# Keys (OpenAI, Twitch, YouTube, Postiz, Upload-Post) are best pasted in the app under Settings:
# they are tested there and used at once. A key in this file is only the fallback.

# --- Where it listens and who may call it ---
# Local only: Caddy is the way in. If you change the port, change the Caddy block too (RUNBOOK.md step 6).
HOST=127.0.0.1
PORT=5310
# clipfarm has no login of its own: Cloudflare Access is the login. With 1, requests that did not
# come through Access (no Cf-Access-Jwt-Assertion header) are refused. Keep it at 1 on the live box.
CLIPFARM_REQUIRE_ACCESS=1

# --- Data (on disk, outside the releases) ---
# SQLite database: /var/lib/clipfarm/clipfarm.db (backed up daily). Final clips: MEDIA_DIR (not backed up).
DATA_DIR=/var/lib/clipfarm
MEDIA_DIR=/var/lib/clipfarm/media
# Days a rejected clip keeps its video files before the daily cleanup deletes them.
MEDIA_KEEP_REJECTED_DAYS=14

# --- Downloading streams ---
# yt-dlp (default) or fake (a generated 10 s test clip, for trying the box without downloading)
DOWNLOADER=yt-dlp
# Full path of yt-dlp (RUNBOOK.md step 2 installs it there).
YT_DLP_BIN=/usr/local/bin/yt-dlp
# Only used with DOWNLOADER=fake: length of the generated clip in seconds.
FAKE_VOD_SEC=

# --- Transcript: openai (default) or fake ---
TRANSCRIBER=openai
OPENAI_API_KEY=

# --- Picking highlights: any OpenAI-compatible API. The key falls back to OPENAI_API_KEY. ---
PICKER=llm
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_USD_PER_MTOK_IN=
LLM_USD_PER_MTOK_OUT=
MAX_PICKS=15

# --- Rendering ---
RENDER_PRESET=veryfast

# --- Posting: the local Postiz (RUNBOOK.md step 11) or Upload-Post. Without either, only Export works. ---
POSTIZ_URL=http://127.0.0.1:5300
POSTIZ_API_KEY=
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
UPLOAD_POST_PLATFORMS=tiktok,youtube,instagram
# postiz or upload-post, only needed when both are set
POSTING_SERVICE=
POSTING_REFRESH_MINUTES=60

# --- Watchlist: new VODs and who is live. Kick needs no key; without the others those platforms are skipped. ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
WATCHLIST_POLL_MINUTES=15

# --- Live mode (the Launch day card): records permitted creators while they are live ---
# A new segment starts every LIVE_SEGMENT_SEC seconds and runs LIVE_OVERLAP_SEC longer (keep it at the longest clip, 60).
LIVE_SEGMENT_SEC=600
LIVE_OVERLAP_SEC=60
# Hours a segment's video is kept (about 3 GB per creator per hour at 1080p).
LIVE_KEEP_HOURS=3
# Clips cut from each segment.
LIVE_MAX_PICKS=3
# The launch time until it is changed on the Launch day card.
LAUNCH_AT=2026-11-19T05:00:00Z
# The app's web address, named to the phones' push services as the sender of notifications.
PUBLIC_URL=https://clip.techinsiderbytes.com

# --- Demo mode: 1 swaps every outside service for a fake. Leave empty on the live box. ---
CLIPFARM_FAKES=
