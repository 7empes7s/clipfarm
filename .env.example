# Copy to .env (never commit it) or export these in your shell.
PORT=3000
# Where the SQLite database lives. Temp job folders go under the OS temp dir.
DATA_DIR=./data
# openai (default) or fake
TRANSCRIBER=openai
OPENAI_API_KEY=
# yt-dlp (default) or fake (generates a 10 s test clip instead of downloading)
DOWNLOADER=yt-dlp
# Set to 1 to use the fake downloader and fake transcriber together (demos, e2e)
CLIPFARM_FAKES=
# Picking model: any OpenAI-compatible API (OpenAI, OpenRouter, Cerebras). Key falls back to OPENAI_API_KEY.
PICKER=llm
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_USD_PER_MTOK_IN=
LLM_USD_PER_MTOK_OUT=
MAX_PICKS=15
# Final clips and thumbnails (never committed)
MEDIA_DIR=./media
RENDER_PRESET=veryfast
