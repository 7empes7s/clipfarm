# Copy to .env (never commit it) or export these in your shell.
PORT=3000
# Address to listen on. Empty = every interface (dev). The live box uses 127.0.0.1 (ops/clipfarm/.env.example).
HOST=
# Set to 1 on the live box: requests are refused unless their Cf-Access-Jwt-Assertion header is a
# token signed by Cloudflare Access for this app. The team and app are found from the public
# address's login link, or pinned with CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD.
CLIPFARM_REQUIRE_ACCESS=
CLIPFARM_PUBLIC_URL=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Where the SQLite database and the local engine's models (DATA_DIR/models) live. Temp job folders go under the OS temp dir.
DATA_DIR=./data
# Transcripts and picks run on this machine by default (whisper.cpp + llama.cpp, downloaded once).
# Set to fake to skip real transcription.
TRANSCRIBER=
# Optional: only for "Use cloud AI for speed" on the Dashboard.
OPENAI_API_KEY=
# Your own whisper.cpp whisper-cli / llama.cpp llama-server (needed where no Linux build is downloaded, e.g. macOS).
WHISPER_BIN=
LLAMA_SERVER_BIN=
# Python 3 for the Moonshine step (default: python3 on the PATH; standard library only).
PYTHON_BIN=
# yt-dlp (default) or fake (generates a 10 s test clip instead of downloading)
DOWNLOADER=yt-dlp
# Set to 1 to use the fake downloader and fake transcriber together (demos, e2e)
CLIPFARM_FAKES=
# Cloud picking model (optional): any OpenAI-compatible API (OpenAI, OpenRouter, Cerebras). Key falls back to OPENAI_API_KEY.
# PICKER=fake skips real picking.
PICKER=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Leave both empty: the models are picked in the app under Settings > OpenAI, and that choice wins over these lines.
LLM_MODEL=
OPENAI_TRANSCRIBE_MODEL=
LLM_USD_PER_MTOK_IN=
LLM_USD_PER_MTOK_OUT=
MAX_PICKS=15
# Final clips and thumbnails (never committed)
MEDIA_DIR=./media
RENDER_PRESET=veryfast
# Posting: Postiz (self-hosted) or Upload-Post (hosted). Without either, only Export works.
POSTIZ_URL=
POSTIZ_API_KEY=
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
UPLOAD_POST_PLATFORMS=tiktok,youtube,instagram
# postiz or upload-post, only needed when both are set
POSTING_SERVICE=
POSTING_REFRESH_MINUTES=60
# What an hour of this server costs in USD, for a clip's compute cost in campaign reports (empty: 0.011)
COMPUTE_USD_PER_HOUR=
# Watchlist: new VODs and who is live. Kick needs no key; without the others those platforms are skipped.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
WATCHLIST_POLL_MINUTES=15
# Public pages the campaign scout starts from, comma-separated (empty: the Content Rewards sitemap and clipping listing)
SCOUT_URLS=

# --- Live mode (the Launch day card): records permitted creators while they are live ---
# A new segment starts every LIVE_SEGMENT_SEC seconds and runs LIVE_OVERLAP_SEC longer (keep it at the longest clip, 60).
LIVE_SEGMENT_SEC=600
LIVE_OVERLAP_SEC=60
# Hours a segment's video is kept (about 3 GB per creator per hour at 1080p).
LIVE_KEEP_HOURS=3
# Clips cut from each segment.
LIVE_MAX_PICKS=3
# Most streams recorded at once; the creators highest on the watchlist go first.
LIVE_MAX_STREAMS=4
# The launch time until it is changed on the Launch day card.
LAUNCH_AT=2026-11-19T05:00:00Z
# The app's web address, named to the phones' push services as the sender of notifications.
PUBLIC_URL=https://clip.techinsiderbytes.com
